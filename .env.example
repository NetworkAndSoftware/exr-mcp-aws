# Only for `npm run build && npm start`, a local run of the server that AWS Lambda hosts.
# On Lambda these come from SSM Parameter Store instead; see `npm run admin`.

# EXR account emails that may connect, comma-separated
ALLOWED_EMAILS=you@example.com

# At least 32 random characters, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
MCP_SIGNING_SECRET=

# To test with MCP Inspector, also allow its OAuth callback:
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost:6274/oauth/callback

# Not read by the server: an EXR account for trying it out locally (sign-in page, test scripts)
EXR_EMAIL=
EXR_PASSWORD=
